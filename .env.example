# ====================================================================
# MFG PREDICTIVE MAINTENANCE & OEE COMMAND CENTER — ENVIRONMENT TEMPLATE
# ====================================================================
# Copy this file to .env or configure environment variables in your environment.
# Note: Atlassian MCP uses OAuth via Snowflake — NO API tokens required in code.
# ====================================================================

# --------------------------------------------------------------------
# 1. SNOWFLAKE DATA CLOUD CONNECTION (REQUIRED for local python scripts)
# --------------------------------------------------------------------
SNOWFLAKE_ACCOUNT=your-account-identifier     # e.g., nvzvuif-nf60009 or xy12345.us-east-1 (REQUIRED)
SNOWFLAKE_USER=YOUR_USERNAME                 # Snowflake username (REQUIRED)
SNOWFLAKE_PASSWORD=YOUR_PASSWORD             # Snowflake password (REQUIRED)
SNOWFLAKE_ROLE=ACCOUNTADMIN                  # Snowflake role (OPTIONAL, default: ACCOUNTADMIN)
SNOWFLAKE_WAREHOUSE=PM_OEE_WH                # Snowflake warehouse (OPTIONAL, default: PM_OEE_WH)
SNOWFLAKE_DATABASE=PM_OEE_DB                 # Snowflake database (OPTIONAL, default: PM_OEE_DB)
SNOWFLAKE_SCHEMA=CORE                        # Snowflake schema (OPTIONAL, default: CORE)

# --------------------------------------------------------------------
# 2. LOCAL JIRA WORKER (OPTIONAL — LOCAL WORKER FALLBACK ONLY)
# Note: Primary Streamlit Judge demo uses Atlassian MCP (OAuth).
# Configure these variables ONLY if running the optional local_jira_worker/ daemon.
# --------------------------------------------------------------------
JIRA_BASE_URL=https://your-org.atlassian.net # Jira Cloud URL (LOCAL WORKER ONLY)
JIRA_USER_EMAIL=your-email@example.com       # Jira user email (LOCAL WORKER ONLY)
JIRA_API_TOKEN=YOUR_JIRA_API_TOKEN           # Jira API Token (LOCAL WORKER ONLY)
JIRA_PROJECT_KEY=KAN                         # Target Jira project key (LOCAL WORKER ONLY)
WORKER_POLL_INTERVAL=10                      # Queue polling interval in seconds (LOCAL WORKER ONLY)
WORKER_MAX_RETRIES=3                         # Maximum retry attempts (LOCAL WORKER ONLY)
WORKER_BATCH_SIZE=5                          # Batch size per poll (LOCAL WORKER ONLY)

# --------------------------------------------------------------------
# 3. NOTIFICATION DISPATCH CHANNELS (OPTIONAL)
# Snowflake Email uses SYSTEM$SEND_EMAIL. Slack uses Webhooks.
# --------------------------------------------------------------------
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR/SLACK/WEBHOOK # Slack incoming webhook (OPTIONAL)
NOTIFICATION_RECIPIENT_EMAIL=verified-email@example.com               # Verified Snowflake email recipient (OPTIONAL)

# --------------------------------------------------------------------
# 4. PLANT LOCATION CONTEXT (OPTIONAL — Open-Meteo Weather API)
# --------------------------------------------------------------------
PLANT_LATITUDE=37.7749                        # Plant latitude (OPTIONAL, default: San Francisco)
PLANT_LONGITUDE=-122.4194                     # Plant longitude (OPTIONAL)
PLANT_LOCATION_NAME=Demo Plant                # Display plant location name (OPTIONAL)
